# Database (PostGIS)
DATABASE_URL=postgresql://safedeliver:safedeliver_dev@localhost:5432/safedeliver

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=14d

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/kakao/callback

# Naver OAuth
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/naver/callback

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/google/callback

# 공공데이터포털 API
DATA_GO_KR_API_KEY=your-data-go-kr-api-key

# Sentry
SENTRY_DSN=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# App
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
