generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

// ──────────────────────────────────────────
// 음식점 (Restaurants)
// ──────────────────────────────────────────
model Restaurant {
  id              String           @id @default(cuid())
  name            String
  normalizedName  String           @map("normalized_name")
  businessNumber  String?          @unique @map("business_number")
  licenseNumber   String?          @map("license_number")
  category        String
  subcategory     String?

  roadAddress     String?          @map("road_address")
  jibunAddress    String?          @map("jibun_address")
  zipCode         String?          @map("zip_code")
  regionCode      String           @map("region_code")

  latitude        Float?
  longitude       Float?

  status          RestaurantStatus @default(ACTIVE)
  totalSanctions  Int              @default(0) @map("total_sanctions")
  phone           String?
  lastSanctionAt  DateTime?        @map("last_sanction_at")

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  sanctions       Sanction[]
  bookmarks       Bookmark[]

  @@index([normalizedName])
  @@index([regionCode])
  @@index([category])
  @@index([status, totalSanctions(sort: Desc)])
  @@index([latitude, longitude])
  @@map("restaurants")
}

enum RestaurantStatus {
  ACTIVE
  CLOSED
  SUSPENDED
  UNKNOWN
}

// ──────────────────────────────────────────
// 행정처분 (Sanctions)
// ──────────────────────────────────────────
model Sanction {
  id                  String           @id @default(cuid())
  restaurantId        String           @map("restaurant_id")
  rawSanctionId       String?          @unique @map("raw_sanction_id")

  sanctionType        SanctionType     @map("sanction_type")
  severity            SanctionSeverity @default(MEDIUM)

  violationContent    String           @map("violation_content")
  dispositionContent  String           @map("disposition_content")
  dispositionDate     DateTime         @map("disposition_date")
  legalBasis          String?          @map("legal_basis")

  matchConfidence     Float            @map("match_confidence")
  isVerified          Boolean          @default(false) @map("is_verified")

  source              String
  sourceId            String?          @map("source_id")

  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  restaurant          Restaurant       @relation(fields: [restaurantId], references: [id])
  rawSanction         RawSanction?     @relation(fields: [rawSanctionId], references: [id])
  alerts              Alert[]

  @@unique([source, sourceId])
  @@index([restaurantId, dispositionDate(sort: Desc)])
  @@index([sanctionType])
  @@index([dispositionDate(sort: Desc)])
  @@index([severity])
  @@map("sanctions")
}

enum SanctionType {
  LICENSE_SUSPENSION
  LICENSE_REVOCATION
  IMPROVEMENT_ORDER
  FINE
  WARNING
  CLOSURE_ORDER
  OTHER
}

enum SanctionSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// ──────────────────────────────────────────
// 원시 수집 데이터 (Raw Sanctions)
// ──────────────────────────────────────────
model RawSanction {
  id                  String           @id @default(cuid())
  sourceType          String           @map("source_type")
  sourceName          String           @map("source_name")
  sourceRecordId      String?          @map("source_record_id")

  rawData             Json             @map("raw_data")
  rawBusinessName     String?          @map("raw_business_name")
  rawAddress          String?          @map("raw_address")

  processingStatus    ProcessingStatus @default(PENDING) @map("processing_status")
  matchedRestaurantId String?          @map("matched_restaurant_id")
  matchConfidence     Float?           @map("match_confidence")
  processingError     String?          @map("processing_error")
  processedAt         DateTime?        @map("processed_at")

  createdAt           DateTime         @default(now()) @map("created_at")

  sanction            Sanction?

  @@unique([sourceName, sourceRecordId])
  @@index([processingStatus])
  @@index([createdAt(sort: Desc)])
  @@map("raw_sanctions")
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  MATCHED
  REVIEW_NEEDED
  COMPLETED
  FAILED
  DUPLICATE
}

// ──────────────────────────────────────────
// 사용자 (Users)
// ──────────────────────────────────────────
model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  passwordHash         String?             @map("password_hash")
  hashedRefreshToken   String?             @map("hashed_refresh_token")
  name                 String?

  provider             AuthProvider?
  providerId           String?             @map("provider_id")

  notificationEnabled  Boolean             @default(true) @map("notification_enabled")
  notificationChannels Json                @default("[]") @map("notification_channels")

  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  bookmarks            Bookmark[]
  alertSubscriptions   AlertSubscription[]
  alerts               Alert[]

  @@unique([provider, providerId])
  @@map("users")
}

enum AuthProvider {
  KAKAO
  NAVER
  GOOGLE
}

// ──────────────────────────────────────────
// 즐겨찾기 (Bookmarks)
// ──────────────────────────────────────────
model Bookmark {
  id              String     @id @default(cuid())
  userId          String     @map("user_id")
  restaurantId    String     @map("restaurant_id")
  createdAt       DateTime   @default(now()) @map("created_at")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@map("bookmarks")
}

// ──────────────────────────────────────────
// 알림 구독 (Alert Subscriptions)
// ──────────────────────────────────────────
model AlertSubscription {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")

  subscriptionType  SubscriptionType @map("subscription_type")
  targetValue       String           @map("target_value")

  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subscriptionType, targetValue])
  @@map("alert_subscriptions")
}

enum SubscriptionType {
  REGION
  CATEGORY
  RESTAURANT
}

// ──────────────────────────────────────────
// 알림 (Alerts)
// ──────────────────────────────────────────
model Alert {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  sanctionId  String    @map("sanction_id")

  alertType   AlertType @map("alert_type")
  title       String
  body        String
  isRead      Boolean   @default(false) @map("is_read")

  sentAt      DateTime  @default(now()) @map("sent_at")
  readAt      DateTime? @map("read_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sanction    Sanction  @relation(fields: [sanctionId], references: [id])

  @@index([userId, isRead, sentAt(sort: Desc)])
  @@index([sanctionId])
  @@map("alerts")
}

enum AlertType {
  BOOKMARK_SANCTION
  REGION_SANCTION
  CATEGORY_SANCTION
}
